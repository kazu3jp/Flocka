{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "tests",
    "e2e",
    "playwright.config.ts",
    "tools/vrt/*.ts",
    "tools/vrt/*.mts"
  ]
}
