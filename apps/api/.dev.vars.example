# Copy to .dev.vars (ignored by Git). Use a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=""
# Optional: API key issued by the Better Auth dashboard (server only).
BETTER_AUTH_API_KEY=""
RESEND_API_KEY=""
# Set to the URL used by clients; use your LAN address for a physical device.
BETTER_AUTH_URL="http://localhost:8787"
RESEND_FROM="Flocka <no-reply@flocka.zofax.net>"
# Optional: each provider is available only when BOTH fields are configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated origins allowed to call the API locally (no spaces). Overrides the
# production value in wrangler.jsonc. Add http://<LAN address>:8081 for a physical device.
ALLOWED_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"
# Optional: Expo push access token, needed only when Enhanced Push Security is enabled.
# EXPO_ACCESS_TOKEN=""
# Optional: comma-separated account IDs allowed to use the moderation endpoints.
# ADMIN_USER_IDS=""
