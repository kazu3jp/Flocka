{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flocka-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://api.flocka.zofax.net",
    "BETTER_AUTH_URL": "https://api.flocka.zofax.net",
    "RESEND_FROM": "Flocka <no-reply@flocka.zofax.net>",
  },
  "routes": [{ "pattern": "api.flocka.zofax.net", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flocka",
      "database_id": "47faa761-6cca-40f5-9e39-f918f1d38dce",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "flocka-avatars",
    },
  ],
}
