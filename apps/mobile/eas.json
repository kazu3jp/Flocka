{
  "cli": {
    "version": ">= 24.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.3",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.flocka.zofax.net"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
