{
  "expo": {
    "name": "Flocka",
    "slug": "flocka",
    "version": "1.0.0",
    "scheme": "flocka",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.kazu3.flocka",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "近くで交換画面を開いている人を見つけ、交換コードを共有するためにBluetoothを使います。"
      }
    },
    "android": {
      "package": "jp.kazu3.flocka",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f8f5e3"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/dela-gothic-one/400Regular/DelaGothicOne_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/zen-kaku-gothic-new/500Medium/ZenKakuGothicNew_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/zen-kaku-gothic-new/700Bold/ZenKakuGothicNew_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "相手のQRを読み取るためにカメラを使います。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真を選ぶために写真を使います。",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser",
      "./plugins/with-utf8-pod-commands.cjs"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05e58101-fca5-4fb0-a5de-4fdf23fde1e2"
      }
    },
    "owner": "kazu3jppurin"
  }
}
