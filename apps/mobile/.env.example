# Required: set the same backend host as BETTER_AUTH_URL.
# Web/iOS simulator: http://localhost:8787 (use localhost for both web and API)
# Android emulator: http://10.0.2.2:8787
# Physical device: use the development computer LAN IP and allow its Expo origin.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Optional, public. The Google "Web application" OAuth client ID. When it is set at
# build time Android signs in with the native Google sheet; otherwise it uses the browser.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
