{
  "name": "flocka",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:mobile": "npm run start -w @flocka/mobile",
    "dev:web": "npm run web -w @flocka/mobile",
    "dev:api": "npm run dev -w @flocka/api",
    "ios": "npm run ios -w @flocka/mobile",
    "android": "npm run android -w @flocka/mobile",
    "db:migrate": "npm run db:migrate -w @flocka/api",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @flocka/mobile && eslint apps/api/src packages/*/src tests",
    "test": "npm run build:api && tsx --test tests/*.test.ts",
    "validate": "npm run typecheck && npm run lint && npm test",
    "export:web": "npm run export:web -w @flocka/mobile",
    "export:native": "npm run export:native -w @flocka/mobile",
    "build:api": "npm run build -w @flocka/api",
    "import:design": "node tools/import-design.cjs",
    "format": "prettier --write apps packages tests tools",
    "setup:local": "node tools/setup-local.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22",
    "eslint": "^9.39.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "miniflare": "^5.20261006.2-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
